# Autorise les requêtes cross-origin depuis les apps Cordova (origine "file://" ou "capacitor://")
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Répond directement aux requêtes preflight OPTIONS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Cache les fichiers sensibles (schema, doc) - Apache 2.4+
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|md)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Fallback pour Apache 2.2 (au cas où)
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
